// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipStatus {
  active
  expired
  trial
  canceled
}

enum PredictionTier {
  free
  premium
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  whopCustomerId String?   @unique @map("whop_customer_id") @db.Text
  email           String?   @unique @db.Text
  name            String?   @db.Text
  avatarUrl       String?   @map("avatar_url") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  
  memberships     Membership[]
  sessions        UserSession[]
  userPlan        UserPlan?
  queryUsage      QueryUsage[]
  queryHistory    QueryHistory[]
  notifications   UserNotification[]
  
  @@map("users")
}

model Membership {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  whopPlanId      String?         @map("whop_plan_id") @db.Text
  status          MembershipStatus
  accessExpiresAt DateTime?       @map("access_expires_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId])
  @@map("memberships")
}

model Prediction {
  id                String        @id @default(uuid()) @db.Uuid
  eventId           String?       @map("event_id") @db.Text
  league            String?       @db.Text
  match             String?       @db.Text
  kickoff           DateTime?     @db.Timestamptz(6)
  oddsHome          Decimal?      @map("odds_home") @db.Decimal
  oddsDraw          Decimal?      @map("odds_draw") @db.Decimal
  oddsAway          Decimal?      @map("odds_away") @db.Decimal
  aiWinProbability  Decimal?      @map("ai_win_probability") @db.Decimal
  aiConfidence      Decimal?      @map("ai_confidence") @db.Decimal
  tier              PredictionTier @default(free)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  
  @@map("predictions")
}

model UserSession {
  token     String   @id @db.Text
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Alert {
  id             String   @id @default(uuid()) @db.Uuid
  tweetId        String   @unique @map("tweet_id") @db.Text
  author         String   @db.Text
  authorHandle   String   @map("author_handle") @db.Text
  sport          String   @db.Text
  text           String   @db.Text
  matchedKeywords String[] @map("matched_keywords") @db.Text
  tweetedAt      DateTime @map("tweeted_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  url            String?  @db.Text
  urgencyScore   Int      @default(0) @map("urgency_score")
  windowTag      String?  @map("window_tag") @db.Text
  isPremium      Boolean  @default(true) @map("is_premium")
  rawJson        Json?    @map("raw_json")

  @@index([sport])
  @@index([tweetedAt])
  @@map("alerts")
}

// ============================================
// BetIntel AI Query System
// ============================================

enum PlanType {
  free
  starter
  sharp
  pro
}

model UserPlan {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  planType        PlanType  @default(free) @map("plan_type")
  queryLimit      Int       @default(5) @map("query_limit")
  whopPlanId      String?   @map("whop_plan_id") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_plans")
}

model QueryUsage {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  periodStart     DateTime  @map("period_start") @db.Timestamptz(6)
  periodEnd       DateTime  @map("period_end") @db.Timestamptz(6)
  queriesUsed     Int       @default(0) @map("queries_used")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, periodStart])
  @@index([userId])
  @@map("query_usage")
}

model QueryHistory {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  query           String    @db.Text
  gameContext     String?   @map("game_context") @db.Text
  sport           String?   @db.Text
  matchup         String?   @db.Text
  responseJson    Json?     @map("response_json")
  confidence      Int?      @default(0)
  isFollowUp      Boolean   @default(false) @map("is_follow_up")
  parentQueryId   String?   @map("parent_query_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([gameContext])
  @@map("query_history")
}

// ============================================
// User Notifications (Pre-match alerts)
// ============================================

enum NotificationType {
  injury
  lineup
  weather
  breaking
}

model UserNotification {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  alertId         String?          @map("alert_id") @db.Uuid
  type            NotificationType @default(breaking)
  title           String           @db.Text
  message         String           @db.Text
  sport           String?          @db.Text
  matchup         String?          @db.Text
  isRead          Boolean          @default(false) @map("is_read")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([isRead])
  @@map("user_notifications")
}
